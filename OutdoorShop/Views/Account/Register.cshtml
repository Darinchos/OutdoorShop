@model OutdoorShop.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="account-page"><div class="account-card auth-card">
    <span class="eyebrow">ПРИКЛЮЧЕНИЯТА ЗАПОЧВАТ ТУК</span>
    <h1>Създай профил</h1>
    <p class="auth-intro">Запази данните си за доставка и следи поръчките си на едно място.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Имейл</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Парола</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Потвърди паролата</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success" data-loading-label="Създаване…">Регистрация</button>
        <a asp-action="Login" class="btn btn-link">Вече имаш профил?</a>
    </form>
</div></section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
