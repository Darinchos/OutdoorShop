@model OutdoorShop.ViewModels.CustomerProfileViewModel
@{
    ViewData["Title"] = "Моят профил";
}
<section class="account-page"><div class="account-card">
    <span class="eyebrow">МОЯТ АКАУНТ</span><h1>Профил</h1>
    @if (TempData["ProfileMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
    <p class="text-muted">Имейл: <strong>@Model.Email</strong></p>
    <form asp-action="Profile" method="post" class="profile-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="3"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
        <div class="form-actions"><button class="btn btn-success" data-loading-label="Запазване…">Запази профила</button>
        <a asp-action="MyOrders" class="btn btn-outline-success">Моите поръчки</a></div>
    </form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
