@model OutdoorShop.Models.Order
@using OutdoorShop.Models
@{
    ViewData["Title"] = $"Поръчка #{Model.Id}";
}
<section class="catalog-page"><a asp-action="MyOrders" class="back-link">← Моите поръчки</a><header class="page-heading"><div><span class="eyebrow">МОЯТ АКАУНТ</span><h1>Поръчка #@Model.Id</h1><p>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") · @OrderStatuses.BulgarianLabel(Model.Status)</p></div></header>
    <div class="orders-card table-responsive"><table class="table align-middle"><thead><tr><th>Продукт</th><th>Ед. цена</th><th>Количество</th><th>Общо</th></tr></thead><tbody>
    @foreach (var item in Model.Items) { <tr><td>@item.ProductName</td><td>@item.Price.ToString("0.00") лв.</td><td>@item.Quantity</td><td>@item.TotalPrice.ToString("0.00") лв.</td></tr> }
    </tbody><tfoot><tr><th colspan="3" class="text-end">Общо</th><th>@Model.TotalPrice.ToString("0.00") лв.</th></tr></tfoot></table></div>
</section>
