@model OutdoorShop.Models.Order
@using OutdoorShop.Models
@{
    ViewData["Title"] = $"Поръчка #{Model.Id}";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="hero-badge">OUTDOORSHOP ADMIN</span>
            <h1>Поръчка #@Model.Id</h1>
            <p class="mb-0">Създадена на @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") · @OrderStatuses.BulgarianLabel(Model.Status)</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Обратно към поръчките</a>
    </div>

    <div class="row g-4">
        @if (TempData["StatusMessage"] is string statusMessage) { <div class="col-12"><div class="alert alert-success" role="status">@statusMessage</div></div> }
        @if (TempData["StatusError"] is string statusError) { <div class="col-12"><div class="alert alert-warning">@statusError</div></div> }
        <div class="col-12"><section class="card"><div class="card-body d-flex flex-wrap align-items-center gap-3">
            <strong>Статус на поръчката</strong>
            <form asp-action="UpdateStatus" method="post" class="order-status-form d-flex flex-wrap gap-2">
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select" aria-label="Статус на поръчката">
                    @foreach (var status in OrderStatuses.AllowedTransitions(Model.Status)) { <option value="@status" selected="@(Model.Status == status)">@OrderStatuses.BulgarianLabel(status)</option> }
                </select>
                <button class="btn btn-success" data-loading-label="Запазване…">Запази статуса</button>
            </form>
        </div></section></div>
        <div class="col-lg-5">
            <section class="card h-100">
                <div class="card-body">
                    <h2 class="h4">Данни за клиента</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Име</dt><dd class="col-sm-8">@Model.CustomerName</dd>
                        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4">Телефон</dt><dd class="col-sm-8">@Model.Phone</dd>
                        <dt class="col-sm-4">Адрес</dt><dd class="col-sm-8">@Model.Address</dd>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="card">
                <div class="card-body">
                    <h2 class="h4">Продукти</h2>
                    @if (Model.Items.Count == 0)
                    {
                        <p class="text-muted mb-0">В тази поръчка няма запазени продуктови редове.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Продукт</th>
                                        <th class="text-end">Цена</th>
                                        <th class="text-end">Количество</th>
                                        <th class="text-end">Общо</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td class="text-end">@item.Price.ToString("0.00") лв.</td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">@item.TotalPrice.ToString("0.00") лв.</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Обща сума</th>
                                        <th class="text-end">@Model.TotalPrice.ToString("0.00") лв.</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
